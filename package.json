{
  "name": "diapason",
  "private": true,
  "version": "1.3.2",
  "description": "Diapasón — La agenda inteligente para profesores de música (PC, Android y web sin conexión)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pc": "vite build --mode pc && node scripts/html-unico.mjs",
