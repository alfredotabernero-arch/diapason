# Evita llamadas de red opcionales que los proxys corporativos suelen bloquear
# (auditoría de seguridad, mensajes de financiación y aviso de nuevas versiones).
audit=false
fund=false
update-notifier=false
# Reintentos más pacientes en redes lentas o filtradas
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
